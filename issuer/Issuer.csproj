<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Babel.Licensing"><HintPath>$(BabelLicensingDirectory)/Babel.Licensing.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireBabelSdk" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(BabelLicensingDirectory)/Babel.Licensing.dll')" Text="Set -p:BabelLicensingDirectory to the directory containing your Babel Licensing .NET SDK assemblies." />
  </Target>
</Project>
